APP_NAME=StockPress
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: https://api.stockpress.itdevstudio.pl
APP_URL=http://localhost:8080

# Frontend origin allowed by CORS.
# Production: https://stockpress.itdevstudio.pl
FRONTEND_URL=http://localhost:5173

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Values match the "db" service in docker-compose.yml.
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=stockpress
DB_USERNAME=stockpress
DB_PASSWORD=stockpress

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Hourly forecast for Katowice (Open-Meteo).
WEATHER_API_URL="https://api.open-meteo.com/v1/forecast?latitude=50.25841&longitude=19.02754&hourly=temperature_2m&timezone=Europe%2FWarsaw&forecast_days=1"
WEATHER_TIMEZONE=Europe/Warsaw

# Requests per minute per IP.
RATE_LIMIT_UPLOADS=20
RATE_LIMIT_DELETES=30
